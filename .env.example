# Vanessa Braz — Beleza & Autoestima
# Copie para .env.local. Nunca commitar secrets.

# App
VITE_APP_URL=http://localhost:3000

# Supabase (anon key only on the client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ATENÇÃO: Nunca expor no client-side! Sem prefixo VITE_.
# Server / Edge functions only.
SUPABASE_SERVICE_ROLE_KEY=

# Payments
PAYMENT_PROVIDER=demo
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# WhatsApp (ainda PENDENTE_DE_CONFIRMACAO no catálogo)
WHATSAPP_NUMBER=
